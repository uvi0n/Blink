<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Blink" Width="960" Height="700" MinWidth="560" MinHeight="430" WindowStartupLocation="CenterScreen" Background="{DynamicResource Base}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True" AllowDrop="True">
<Window.Resources><SolidColorBrush x:Key="Accent" Color="#FFAE79"/>
<Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="MinHeight" Value="39"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Round}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Background="Transparent"><Border x:Name="square" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Background="{DynamicResource Surface}" Width="20" Height="20"><TextBlock x:Name="tick" Text="✓" Visibility="Hidden" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="square" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="square" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Padding="10,6" CornerRadius="6" Background="{DynamicResource Surface}"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{DynamicResource Accent}" Margin="12,0,0,0"/><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" TextElement.Foreground="{DynamicResource Text}"/></DockPanel></ToggleButton><Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="3"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<DockPanel Margin="24,16,24,18">
<DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" VerticalAlignment="Top" Name="Bug" FontFamily="Segoe MDL2 Assets" Content="&#xEBE8;" ToolTip="Нашёл баг" AutomationProperties.Name="Нашёл баг"/><StackPanel Name="Navigation" Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Name="Badge" Width="42" Height="36"/><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="24">Blink</TextBlock></StackPanel><WrapPanel Name="Tabs"><Button Name="SendTab">Отправить</Button><Button Name="ReceiveTab">Запросить</Button><Button Name="Settings" ToolTip="Настройки" AutomationProperties.Name="Настройки" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"/></WrapPanel></StackPanel></DockPanel>
<Grid><ContentControl Name="SettingsHost" Visibility="Collapsed"/><ScrollViewer Name="TransferPage" VerticalScrollBarVisibility="Auto"><Grid Name="Workspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
<Border Grid.ColumnSpan="2" Background="{DynamicResource HeroBrush}" CornerRadius="{DynamicResource Round}" Padding="22,18" Margin="0,0,0,14">
<Grid>
  <Viewbox Name="Artwork" HorizontalAlignment="Right" Width="214" Height="108" IsHitTestVisible="False">
    <Canvas Width="214" Height="108">
      <Path Stroke="{DynamicResource Muted}" Opacity=".24" StrokeThickness="1" Data="M0,87 L44,87 83,48 130,48 146,32 214,32 M0,98 L52,98 91,59 150,59 164,45 214,45 M62,13 L115,13 134,32"/>
      <Ellipse Canvas.Left="30" Canvas.Top="83" Width="8" Height="8" Fill="{DynamicResource Accent}"/>
      <Ellipse Canvas.Left="203" Canvas.Top="28" Width="8" Height="8" Fill="{DynamicResource Accent}"/>
      <Image Name="HeroBadge" Canvas.Left="75" Canvas.Top="6" Width="94" Height="94"/>
    </Canvas>
  </Viewbox>
  <StackPanel Name="HeroWords" Margin="0,0,227,0" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Ellipse Name="StatusLamp" Width="9" Height="9" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Name="SessionPhase" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="7,0,0,0"/></StackPanel>
    <TextBlock Name="Hero" FontSize="35" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Name="Hint" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
  </StackPanel>
</Grid></Border>
<Border Name="SelectionCard" Grid.Row="1" CornerRadius="{DynamicResource Round}" Background="{DynamicResource Card}" Padding="20,16" Margin="0,0,0,12"><StackPanel>
<DockPanel LastChildFill="True"><TextBlock Name="SizeTotal" DockPanel.Dock="Right" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock Name="Section" FontSize="20" FontWeight="SemiBold"/></DockPanel>
<StackPanel Name="SendPane"><StackPanel Name="MixPanel" Visibility="Collapsed" Margin="0,12,0,0"><Grid Name="MixBar" Height="7" ClipToBounds="True"/><WrapPanel Name="MixLegend" Margin="0,6,0,0"/></StackPanel><Border Margin="0,12,0,12" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Round}"><Grid MinHeight="102"><StackPanel Name="DropZone" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
<Path Width="21" Height="24" Margin="0,0,0,5" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Data="M4,1 L15,1 20,6 20,23 4,23 Z M14,2 L14,7 19,7 M8,14 L16,14 M12,10 L12,18"/>
<TextBlock Name="DropHint" Text="Перетащите файлы сюда" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></StackPanel><ListBox Name="Queue" Foreground="{DynamicResource Text}" Background="Transparent" BorderThickness="0" MaxHeight="170" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#365267"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#365267"/></ListBox.Resources><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="9,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource Muted}" Margin="16,0,8,0" VerticalAlignment="Center"/><Button Grid.Column="2" Tag="RemoveEntry" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Padding="9,4" MinHeight="30" Margin="0" IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}" ToolTip="Убрать из подборки" AutomationProperties.Name="Убрать из подборки"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><WrapPanel><Button Name="Add" ToolTip="Добавить файлы (Ctrl+O)">Добавить файлы</Button><Button Name="FolderAdd">Добавить папку</Button><Button Name="Remove">Убрать выбранные</Button></WrapPanel>
<Expander Name="PrivacyTools" Header="Приватные файлы" Foreground="{DynamicResource Text}" Margin="0,10,0,0"><StackPanel><TextBlock Margin="0,6" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Text="Blink создаёт копию файла, зашифрованную паролем. Передайте пароль получателю отдельно. Для открытия копии выберите «Расшифровать»."/><WrapPanel Margin="0,8,0,0"><Button Name="Encrypt">Зашифровать файл</Button><Button Name="Unlock">Расшифровать</Button></WrapPanel></StackPanel></Expander></StackPanel>
<StackPanel Name="ReceivePane"><CheckBox Name="Collect" Foreground="{DynamicResource Text}" Content="Собрать файлы от нескольких людей"/><TextBlock Name="FolderPath" Margin="0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><WrapPanel><Button Name="Desktop">Рабочий стол</Button><Button Name="Browse">Выбрать папку…</Button></WrapPanel><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">Файл сохранится под исходным именем. При совпадении добавится номер.</TextBlock></StackPanel></StackPanel></Border>
<Border VerticalAlignment="Top" Name="LinkCard" Grid.Row="2" CornerRadius="{DynamicResource Round}" Background="{DynamicResource Card}" Padding="20,16"><StackPanel><TextBlock Text="Ссылка на передачу" FontSize="20" FontWeight="SemiBold"/><TextBlock Name="LinkExpiry" Margin="0,5,0,1" FontSize="14" Foreground="{DynamicResource Muted}"/><CheckBox Name="Approve" Margin="0,12,0,3" Foreground="{DynamicResource Text}" Content="Подтверждать получателей"/><TextBlock Name="State" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBox Name="Address" Visibility="Collapsed" IsReadOnly="True" Foreground="{DynamicResource Text}" Background="{DynamicResource Base}" BorderThickness="0" Padding="10" Margin="0,0,0,10"/><WrapPanel><Button Name="Create" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}">Создать ссылку</Button><Button Name="Copy">Копировать</Button><Button Name="QrButton">QR-код</Button><Button Name="Backup">Запасной адрес</Button><Button Name="NewTransfer" ToolTip="Открыть отдельное окно передачи">Новая передача</Button><Button Name="Stop">Отозвать</Button></WrapPanel><Image Name="Qr" Visibility="Collapsed" Width="228" Height="228" HorizontalAlignment="Left" Margin="0,8" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR-код ссылки"/><StackPanel Name="LivePanel" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock Name="LiveCaption" Foreground="{DynamicResource Muted}" FontSize="14" TextWrapping="Wrap"/><Grid Height="6" Background="{DynamicResource Surface}" Margin="0,6,0,0"><Border Name="LiveFill" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0"><Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform></Border></Grid></StackPanel><TextBlock Name="Outgoing" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
</Grid></ScrollViewer></Grid></DockPanel></Window>



