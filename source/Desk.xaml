<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Blink" Width="960" Height="700" MinWidth="560" MinHeight="430" WindowStartupLocation="CenterScreen" Background="{DynamicResource Base}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="15" UseLayoutRounding="True" AllowDrop="True">
<Window.Resources><SolidColorBrush x:Key="Accent" Color="#FFAE79"/>
<Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="MinHeight" Value="39"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Round}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<DockPanel Margin="24,16,24,18">
<StackPanel Name="Navigation" Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Name="Badge" Width="42" Height="36"/><TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="24">Blink</TextBlock></StackPanel><WrapPanel Name="Tabs"><Button Name="SendTab">Отправить</Button><Button Name="ReceiveTab">Запросить</Button><Button Name="Settings" ToolTip="Настройки" AutomationProperties.Name="Настройки" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"/></WrapPanel></StackPanel>
<Grid><ContentControl Name="SettingsHost" Visibility="Collapsed"/><ScrollViewer Name="TransferPage" VerticalScrollBarVisibility="Auto"><Grid Name="Workspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
<Border Grid.ColumnSpan="2" Background="{DynamicResource HeroBrush}" CornerRadius="{DynamicResource Round}" Padding="22,18" Margin="0,0,0,14">
<Grid><Viewbox Name="Artwork" HorizontalAlignment="Right" Width="128" Height="93" Opacity=".94" IsHitTestVisible="False"><Image Name="HeroBadge" Width="104" Height="80"/></Viewbox><StackPanel Name="HeroWords" Margin="0,0,123,0" VerticalAlignment="Center"><TextBlock Name="Hero" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Name="Hint" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Grid></Border>
<Border Name="SelectionCard" Grid.Row="1" CornerRadius="{DynamicResource Round}" Background="{DynamicResource Card}" Padding="20,16" Margin="0,0,0,12"><StackPanel>
<TextBlock Name="Section" FontSize="18" FontWeight="SemiBold"/>
<StackPanel Name="SendPane"><Border Margin="0,12,0,12" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Round}"><Grid MinHeight="85"><TextBlock Name="DropHint" Text="Перетащите файлы сюда" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ListBox Name="Queue" Foreground="{DynamicResource Text}" Background="Transparent" BorderThickness="0" MaxHeight="170" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#365267"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#365267"/></ListBox.Resources><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid Margin="9,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><WrapPanel><Button Name="Add">Добавить файлы</Button><Button Name="FolderAdd">Добавить папку</Button><Button Name="Encrypt">Зашифровать файл</Button><Button Name="Unlock">Расшифровать</Button><Button Name="Remove">Убрать выбранные</Button></WrapPanel></StackPanel>
<StackPanel Name="ReceivePane"><CheckBox Name="Collect" Foreground="{DynamicResource Text}" Content="Собрать файлы от нескольких людей"/><TextBlock Name="FolderPath" Margin="0,12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><WrapPanel><Button Name="Desktop">Рабочий стол</Button><Button Name="Browse">Выбрать папку…</Button></WrapPanel><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">Файл сохранится под исходным именем. При совпадении добавится номер.</TextBlock></StackPanel></StackPanel></Border>
<Border Name="LinkCard" Grid.Row="2" CornerRadius="{DynamicResource Round}" Background="{DynamicResource Card}" Padding="20,16"><StackPanel><TextBlock Text="Ссылка на передачу" FontSize="18" FontWeight="SemiBold"/><CheckBox Name="Approve" Foreground="{DynamicResource Text}" Content="Подтверждать получателей"/><TextBlock Name="State" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBox Name="Address" Visibility="Collapsed" IsReadOnly="True" Foreground="{DynamicResource Text}" Background="{DynamicResource Base}" BorderThickness="0" Padding="10" Margin="0,0,0,10"/><WrapPanel><Button Name="Create" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}">Создать ссылку</Button><Button Name="Copy">Копировать</Button><Button Name="QrButton">QR-код</Button><Button Name="Backup">Запасной адрес</Button><Button Name="Stop">Отозвать</Button></WrapPanel><Image Name="Qr" Visibility="Collapsed" Width="228" Height="228" HorizontalAlignment="Left" Margin="0,8" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR-код ссылки"/><TextBlock Name="Outgoing" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
</Grid></ScrollViewer></Grid></DockPanel></Window>


