<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
<ScrollViewer.Resources>
<Style x:Key="group" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Padding" Value="18,14"/><Setter Property="CornerRadius" Value="{DynamicResource Round}"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
<Style x:Key="heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,6,0,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</ScrollViewer.Resources>
<StackPanel Margin="2,0,12,4">
<TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,14"/>
<Border Style="{StaticResource group}"><StackPanel><TextBlock Text="Оформление" Style="{StaticResource heading}"/>
<WrapPanel><StackPanel Margin="0,0,18,6"><TextBlock Text="Тема" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><ComboBox Name="ThemeChoice" MinWidth="165" Padding="8,6" AutomationProperties.Name="Тема интерфейса"/></StackPanel>
<StackPanel><TextBlock Text="Акцент темы" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><WrapPanel><Button Name="Rgb" ToolTip="Выбрать цвет RGB"/><Button Name="ResetColor">Сбросить цвет</Button></WrapPanel></StackPanel></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource group}"><StackPanel><TextBlock Text="Файлы и ссылки" Style="{StaticResource heading}"/>
<TextBlock Text="Папка для входящих файлов" Foreground="{DynamicResource Muted}"/><DockPanel Margin="0,5,0,9"><Button DockPanel.Dock="Right" Name="Browse">Изменить…</Button><TextBlock Name="Folder" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/></DockPanel>
<WrapPanel><TextBlock VerticalAlignment="Center" Text="Срок новых ссылок, ч" Margin="0,0,14,0"/><ComboBox Name="Hours" Width="88" Padding="8,4" AutomationProperties.Name="Срок новых ссылок в часах"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource group}"><StackPanel><TextBlock Text="Работа приложения" Style="{StaticResource heading}"/><CheckBox Name="Tray">При закрытии сворачивать в трей</CheckBox><CheckBox Name="Confirm"><TextBlock TextWrapping="Wrap">Спрашивать перед выходом при активной ссылке</TextBlock></CheckBox><CheckBox Name="AutoUpdate">Автоматически скачивать обновления</CheckBox>
<DockPanel Margin="0,9,0,0"><Button DockPanel.Dock="Right" Name="CheckUpdates">Проверить обновления</Button><TextBlock Name="UpdateStatus" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/></DockPanel>
</StackPanel></Border>
<TextBlock Name="Error" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/><WrapPanel><Button Name="Save" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" IsDefault="True">Сохранить</Button><Button Name="Cancel">Отмена</Button></WrapPanel>
</StackPanel></ScrollViewer>
