<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24"><TextBlock FontSize="27" FontWeight="SemiBold" Margin="0,0,0,16">Настройки</TextBlock><Border Background="{DynamicResource Card}" Padding="16" CornerRadius="{DynamicResource Round}"><StackPanel>
<TextBlock FontWeight="SemiBold">Папка для входящих файлов</TextBlock><TextBlock Name="Folder" Foreground="{DynamicResource Muted}" Margin="0,6,0,8" TextWrapping="Wrap"/><Button Name="Browse" HorizontalAlignment="Left">Изменить папку…</Button>
<TextBlock Margin="0,14,0,6" FontWeight="SemiBold">Срок новых ссылок, ч</TextBlock><ComboBox Name="Hours" Width="110" HorizontalAlignment="Left" Padding="8,4" AutomationProperties.Name="Срок новых ссылок в часах"/>
<TextBlock Margin="0,14,0,6" FontWeight="SemiBold">Дизайн приложения</TextBlock><ComboBox Name="ThemeChoice" Width="200" HorizontalAlignment="Left" Padding="8,4"/><TextBlock Margin="0,12,0,6">Акцент этой темы</TextBlock><WrapPanel><Button Name="Rgb" ToolTip="Открыть RGB-палитру"/><Button Name="ResetColor">Исходный цвет</Button></WrapPanel>
<CheckBox Name="Tray" Margin="0,16,0,4" Foreground="{DynamicResource Text}">При закрытии сворачивать в трей</CheckBox>
<CheckBox Name="Confirm" Margin="0,20,0,4" Foreground="{DynamicResource Text}"><TextBlock TextWrapping="Wrap">Спрашивать перед выходом при активной ссылке</TextBlock></CheckBox>
</StackPanel></Border><TextBlock Name="Error" Foreground="#FFAE79" TextWrapping="Wrap"/><WrapPanel Margin="0,16,0,0"><Button Name="Save" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" IsDefault="True">Сохранить</Button><Button Name="Cancel">Отмена</Button></WrapPanel></StackPanel></ScrollViewer>